# Anthropic API key, read only by the API server (server/index.js) and never sent to the browser.
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional: number of reverse proxies in front of the server (e.g. 1 behind nginx or a
# hosting platform's router) so per-client rate limiting sees real client IPs.
# Leave unset when browsers connect to the server directly.
# TRUST_PROXY=1
